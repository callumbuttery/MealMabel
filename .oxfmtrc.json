{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    ".claude/**",
    "node_modules/**",
    ".expo/**",
    "dist/**",
    "web-build/**",
    "coverage/**",
    "ios/**",
    "android/**"
  ]
}
